# =====================================================
# CLIENT-SIDE (browser-exposed) — used by Vite
# =====================================================
# Copy to .env.local and fill in.
# Get key from: https://console.anthropic.com/

# VITE_ANTHROPIC_API_KEY=sk-ant-...

# =====================================================
# SERVER-SIDE (Vercel serverless functions only)
# These are NEVER exposed to the browser.
# Set them in Vercel project settings: https://vercel.com/<your>/<project>/settings/environment-variables
# =====================================================

# Resend API key for /api/send-lead — get from https://resend.com/api-keys
# RESEND_API_KEY=re_...

# Email recipient for lead capture form (default: t.ficek@gmail.com)
# LEAD_TO_EMAIL=t.ficek@gmail.com

# From address for outgoing emails. Default uses Resend test sender.
# Once you verify digitalevolution.sk in Resend (https://resend.com/domains),
# change to a verified address e.g. "DE Demo <demo@digitalevolution.sk>"
# LEAD_FROM_EMAIL=DE Demo <onboarding@resend.dev>
